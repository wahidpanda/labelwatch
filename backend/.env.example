ENV=dev
# --- Supabase (free project). Get from Supabase dashboard > Connect
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL_MIGRATIONS=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
ADMIN_EMAILS=you@example.com
CORS_ORIGINS=http://localhost:5173
CONTACT_EMAIL=you@example.com
# --- LLM providers (model names change often, check each provider console)
LLM_PROVIDER_ORDER=google_genai,openrouter,groq,ollama
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_CLASSIFY_google_genai=
LLM_MODEL_JUDGE_google_genai=
LLM_MODEL_ASSISTANT_google_genai=
LLM_MODEL_CLASSIFY_groq=
LLM_MODEL_JUDGE_groq=
LLM_MODEL_ASSISTANT_groq=
LLM_MODEL_CLASSIFY_openrouter=
LLM_MODEL_JUDGE_openrouter=
LLM_MODEL_ASSISTANT_openrouter=
LLM_DAILY_CAP_google_genai=200
LLM_DAILY_CAP_groq=500
LLM_DAILY_CAP_openrouter=50
LLM_RPS_google_genai=0.1
LLM_RPS_groq=0.3
LLM_RPS_openrouter=0.2
# --- LangSmith (free plan: 5,000 traces/month)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=label-lag-radar-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
TRACE_SAMPLE_RATE=0.2
# --- Limits
DB_SIZE_LIMIT_MB=400
STALE_DAYS=90
