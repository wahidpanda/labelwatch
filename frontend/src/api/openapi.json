    "/api/v1/drugs/{drug_id}/events": {
      "get": {
        "operationId": "list_drug_events_api_v1_drugs__drug_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "drug_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Drug Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "severity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "boxed",
                    "major",
                    "moderate",
                    "minor"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Severity"
            }
          },
          {
            "in": "query",
            "name": "section_key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "boxed_warning",
                    "warnings_precautions",
                    "warnings",
                    "precautions",
                    "adverse_reactions",
                    "contraindications",
                    "drug_interactions",
                    "specific_populations",
                    "pregnancy"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Section Key"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_EventSummary_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Drug Events",
        "tags": [
          "catalog"
        ]
